# remotes::install_github("coolbutuseless/ggpattern")
suppressPackageStartupMessages({
library(tidyverse)
library(ggpattern)
})
dat <- read.csv("https://raw.githubusercontent.com/ajstarks/dubois-data-portraits/master/challenge/2024/challenge05/data.csv")
dat
colors_ch5 <- c("#1C1C1Bff","#2A1A12ff","#FDBA00ff")
bistre= "#2A1A12ff"
almond= "#E6D7C6ff"
eerie_black= "#1C1C1Bff"
selective_yellow= "#FDBA00ff"
beaver= "#A49689ff"
red="#dc143c"
library(showtext)
library(sysfonts)
sysfonts::font_add_google(name="Public Sans",
family = "Public Sans",
regular.wt = 100)
sysfonts::font_add_google(name="Public Sans",
family = "Public Sans-med",
regular.wt = 200)
showtext_auto()
showtext::showtext_opts(dpi=320)
dat%>%
ggplot(aes(x=Category,y=Percentage,fill=Category))+
geom_col()+
scale_fill_manual(values=colors_ch5)+
theme_minimal()
dat%>%
ggplot(aes(x=1,y=Percentage,
group=Category,
fill=Category))+
geom_col()+
scale_fill_manual(values=colors_ch5)+
theme_minimal()
plot1 <- dat%>%
ggplot(aes(x=1,y=Percentage,
group=Category))+
geom_col_pattern(
aes(pattern_fill = Category,fill=Category),
width=0.8,
show.legend = F,
pattern       = 'plasma',
colour        = 'black',
linewidth=0.1,
) +
scale_pattern_fill_manual(values=colors_ch5)+
geom_text(y=c(dat$Percentage[3]+dat$Percentage[2]+dat$Percentage[1]/2,
dat$Percentage[3]+dat$Percentage[2]/2,
dat$Percentage[3]/2),
aes(label=paste0(Percentage,"%")),
color=c("#E6D7C6ff","#dc143c","#1C1C1Bff"),
position = "identity",
family="Public Sans-med")+
coord_cartesian(xlim = c(0.5,1.5))+
theme_minimal(base_family = "Public Sans")
plot1
plot1 + patchwork::plot_layout(ncol = 2)
plot2 <- dat %>%
ggplot(aes(x=1,y= Percentage-5))+
geom_text(aes(label=Category))+
xlim(0.8,1.2)+
ylim(0,max(dat$Percentage))+
theme_minimal()
plot2
(plot2 + plot1) +
plot_annotation(
title="RACE AMALGAMATION IN GEORGIA .",
subtitle = "BASED ON A STUDY OF 40,000 INDIVIDUALS OF NEGRO DESCENT.")+
patchwork::plot_layout(ncol = 2,widths = c(1/3,1)) &
theme_void() &
theme(plot.title = element_text(hjust=0.5,
family="Public Sans-med"),
plot.subtitle = element_text(hjust=0.5,
family="Public Sans"))
