        "\n [13] \"Libraries\"                                                                                                                                                                                                                                                                                                                  \n [14] \"```{r message=FALSE, warning=FALSE}\"                                                                                                                                                                                                                                                                                        ",
        "\n [15] \"library(tidyverse)\"                                                                                                                                                                                                                                                                                                         \n [16] \"library(lubridate)\"                                                                                                                                                                                                                                                                                                         ",
        "\n [17] \"library(scales)\"                                                                                                                                                                                                                                                                                                            \n [18] \"library(DT)\"                                                                                                                                                                                                                                                                                                                ",
        "\n [19] \"library(unvotes)\"                                                                                                                                                                                                                                                                                                           \n [20] \"library(tidytuesdayR)\"                                                                                                                                                                                                                                                                                                      ",
        "\n [21] \"library(ggplot2)\"                                                                                                                                                                                                                                                                                                           \n [22] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [23] \"library(showtext)\"                                                                                                                                                                                                                                                                                                          \n [24] \"font_add_google(\\\"Share Tech Mono\\\", \\\"techmono\\\")\"                                                                                                                                                                                                                                                                         ",
        "\n [25] \"showtext_opts(dpi = 320)\"                                                                                                                                                                                                                                                                                                   \n [26] \"showtext_auto(enable = FALSE)\"                                                                                                                                                                                                                                                                                              ",
        "\n [27] \"```\"                                                                                                                                                                                                                                                                                                                        \n [28] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [29] \"Get data\"                                                                                                                                                                                                                                                                                                                   \n [30] \"```{r message=FALSE, warning=FALSE}\"                                                                                                                                                                                                                                                                                        ",
        "\n [31] \"unvotes <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2021/2021-03-23/unvotes.csv')\"                                                                                                                                                                                        \n [32] \"roll_calls <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2021/2021-03-23/roll_calls.csv')\"                                                                                                                                                                                  ",
        "\n [33] \"issues <- readr::read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2021/2021-03-23/issues.csv')\"                                                                                                                                                                                          \n [34] \"```\"                                                                                                                                                                                                                                                                                                                        ",
        "\n [35] \"\"                                                                                                                                                                                                                                                                                                                           \n [36] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [37] \"UNvotes_full and UNvotes_sub\"                                                                                                                                                                                                                                                                                               \n [38] \"```{r}\"                                                                                                                                                                                                                                                                                                                     ",
        "\n [39] \"unvotes_full <- unvotes %>%\"                                                                                                                                                                                                                                                                                                \n [40] \"  inner_join(un_roll_calls, by = \\\"rcid\\\") %>%\"                                                                                                                                                                                                                                                                             ",
        "\n [41] \"  inner_join(un_roll_call_issues, by = \\\"rcid\\\")\"                                                                                                                                                                                                                                                                           \n [42] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [43] \"unvotes_sub <- unvotes_full%>%\"                                                                                                                                                                                                                                                                                             \n [44] \"  select(date,country,session,vote,issue)\"                                                                                                                                                                                                                                                                                  ",
        "\n [45] \"```\"                                                                                                                                                                                                                                                                                                                        \n [46] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [47] \"UN Countries\"                                                                                                                                                                                                                                                                                                               \n [48] \"```{r}\"                                                                                                                                                                                                                                                                                                                     ",
        "\n [49] \"german<-unvotes_full%>%filter(str_detect(country, \\\"Germ\\\"))\"                                                                                                                                                                                                                                                               \n [50] \"#table(german$country)\"                                                                                                                                                                                                                                                                                                     ",
        "\n [51] \"congo<-unvotes_full%>%filter(str_detect(country, \\\"Congo\\\"))\"                                                                                                                                                                                                                                                               \n [52] \"#table(congo$country)\"                                                                                                                                                                                                                                                                                                      ",
        "\n [53] \"yemen<-unvotes_full%>%filter(str_detect(country, \\\"Yemen\\\"))\"                                                                                                                                                                                                                                                               \n [54] \"#table(yemen$country)\"                                                                                                                                                                                                                                                                                                      ",
        "\n [55] \"guinea<-unvotes_full%>%filter(str_detect(country, \\\"Guinea\\\"))\"                                                                                                                                                                                                                                                             \n [56] \"#table(guinea$country)\"                                                                                                                                                                                                                                                                                                     ",
        "\n [57] \"\"                                                                                                                                                                                                                                                                                                                           \n [58] \"unvotes_merged_country_names<-unvotes_sub%>%\"                                                                                                                                                                                                                                                                               ",
        "\n [59] \"  mutate(country=case_when(country==\\\"Federal Republic of Germany\\\"~\\\"Germany\\\",\"                                                                                                                                                                                                                                           \n [60] \"                           country==\\\"German Democratic Republic\\\"~\\\"Germany\\\",\"                                                                                                                                                                                                                                            ",
        "\n [61] \"                           country==\\\"Congo - Brazzaville\\\"~\\\"Congo\\\",\"                                                                                                                                                                                                                                                     \n [62] \"                           country==\\\"Congo - Kinshasa\\\"~\\\"Congo\\\",\"                                                                                                                                                                                                                                                        ",
        "\n [63] \"                           country==\\\"Micronesia (Federated States of)\\\"~\\\"Micronesia\\\",\"                                                                                                                                                                                                                                   \n [64] \"                           country==\\\"Myanmar (Burma)\\\"~\\\"Myanmar\\\",\"                                                                                                                                                                                                                                                       ",
        "\n [65] \"                           country==\\\"Yemen Arab Republic\\\"~\\\"Yemen\\\",\"                                                                                                                                                                                                                                                     \n [66] \"                           country==\\\"Yemen People's Republic\\\"~\\\"Yemen\\\",\"                                                                                                                                                                                                                                                 ",
        "\n [67] \"                           country==\\\"Guinea-Bissau\\\"~\\\"Giunea\\\",\"                                                                                                                                                                                                                                                          \n [68] \"                           TRUE~country))%>%\"                                                                                                                                                                                                                                                                               ",
        "\n [69] \"  select(date,country,vote,issue) %>%\"                                                                                                                                                                                                                                                                                      \n [70] \"  arrange(date)\"                                                                                                                                                                                                                                                                                                            ",
        "\n [71] \"```\"                                                                                                                                                                                                                                                                                                                        \n [72] \"\"                                                                                                                                                                                                                                                                                                                           ",
        "\n [73] \"by_country_year\"                                                                                                                                                                                                                                                                                                            \n [74] \"```{r message=FALSE, warning=FALSE}\"                                                                                                                                                                                                                                                                                        ",
